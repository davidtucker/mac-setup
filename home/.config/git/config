# Git settings shared by every Mac. Your name and email are in ~/.gitconfig,
# which setup writes and which isn't in this repo.

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[diff]
	colorMoved = default

[merge]
	conflictStyle = zdiff3

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
